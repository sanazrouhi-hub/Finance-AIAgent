# Copy to .env and fill in. .env is git-ignored.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried in order when a model runs out of quota (free-tier limits are per model)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-flash-lite-latest

# Optional: enables Agent 2's LLM refinement step
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: web console bind address
# HOST=0.0.0.0
# PORT=8000
